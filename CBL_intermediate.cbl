IDENTIFICATION DIVISION.
 PROGRAM-ID. DEPOSIT-TEST.
 DATA DIVISION.
 WORKING-STORAGE SECTION.
 01 TEST-DATA.
 05 AMOUNT-TEXT PIC X(10) OCCURS 8 TIMES.
 01 I PIC 99.
 01 AMOUNT-VALUE PIC 9(9)V99.
 01 DECIMAL-COUNT PIC 99.
 01 DOT-FOUND PIC X.
 01 VALID-FLAG PIC X.
 01 NUM-LEN PIC 99.
 01 CHAR-POS PIC 99.
 PROCEDURE DIVISION.
 MOVE "2500.50" TO AMOUNT-TEXT(1)
 MOVE "1" TO AMOUNT-TEXT(2)
 MOVE "500000.00" TO AMOUNT-TEXT(3)
 MOVE "0" TO AMOUNT-TEXT(4)
 MOVE "-100" TO AMOUNT-TEXT(5)
 MOVE "500001" TO AMOUNT-TEXT(6)
 MOVE "10.123" TO AMOUNT-TEXT(7)
 MOVE "abc" TO AMOUNT-TEXT(8)
 PERFORM VARYING I FROM 1 BY 1
 UNTIL I > 8
 MOVE 'Y' TO VALID-FLAG
 MOVE 'N' TO DOT-FOUND
 MOVE 0 TO DECIMAL-COUNT
 COMPUTE NUM-LEN =
 FUNCTION LENGTH(
 FUNCTION TRIM(AMOUNT-TEXT(I)))
 PERFORM VARYING CHAR-POS FROM 1 BY 1
 UNTIL CHAR-POS > NUM-LEN
 IF AMOUNT-TEXT(I)(CHAR-POS:1) = '.'
 MOVE 'Y' TO DOT-FOUND
 ELSE
 IF DOT-FOUND = 'Y'
 ADD 1 TO DECIMAL-COUNT
 END-IF
 END-IF
 END-PERFORM
 IF DECIMAL-COUNT > 2
 MOVE 'N' TO VALID-FLAG
 END-IF
 IF FUNCTION TEST-NUMVAL(
 FUNCTION TRIM(AMOUNT-TEXT(I))) NOT = 0
 MOVE 'N' TO VALID-FLAG
 ELSE
 IF FUNCTION NUMVAL(
 AMOUNT-TEXT(I)) < 1 OR
 FUNCTION NUMVAL(
 AMOUNT-TEXT(I)) > 500000
 MOVE 'N' TO VALID-FLAG
 END-IF
 END-IF
 IF VALID-FLAG = 'Y'
 DISPLAY FUNCTION TRIM(AMOUNT-TEXT(I))
 " : VALID"
 ELSE
 DISPLAY FUNCTION TRIM(AMOUNT-TEXT(I))
 " : INVALID"
 END-IF
 END-PERFORM
 STOP RUN.
