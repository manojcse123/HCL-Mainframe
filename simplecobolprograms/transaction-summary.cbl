
>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. TRANSACTION-SUMMARY.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TRANSACTION-FILE
        ASSIGN TO "TRANSACT.TXT"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD TRANSACTION-FILE.
01 INPUT-RECORD PIC X(80).

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS       PIC XX.
01 WS-EOF               PIC X VALUE "N".

01 WS-TRANSACTION-ID    PIC X(10).
01 WS-TRANSACTION-TYPE  PIC X.
01 WS-AMOUNT-TEXT       PIC X(15).

01 WS-AMOUNT            PIC S9(12).
01 WS-TOTAL             PIC 9(18) VALUE ZERO.

01 WS-VALID-COUNT       PIC 9(6) VALUE ZERO.
01 WS-REJECTED-COUNT    PIC 9(6) VALUE ZERO.

PROCEDURE DIVISION.
    OPEN INPUT TRANSACTION-FILE

    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "ERROR OPENING INPUT FILE"
        DISPLAY "FILE STATUS: " WS-FILE-STATUS
        STOP RUN
    END-IF

    PERFORM UNTIL WS-EOF = "Y"
        READ TRANSACTION-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                PERFORM PROCESS-RECORD
        END-READ
    END-PERFORM

    CLOSE TRANSACTION-FILE

    DISPLAY "Valid records: " WS-VALID-COUNT
    DISPLAY "Rejected records: " WS-REJECTED-COUNT
    DISPLAY "Valid amount total: " WS-TOTAL

    STOP RUN.

PROCESS-RECORD.
    MOVE SPACES TO WS-TRANSACTION-ID
                   WS-TRANSACTION-TYPE
                   WS-AMOUNT-TEXT

    UNSTRING INPUT-RECORD
        DELIMITED BY ALL SPACES
        INTO WS-TRANSACTION-ID
             WS-TRANSACTION-TYPE
             WS-AMOUNT-TEXT
    END-UNSTRING

    IF (WS-TRANSACTION-TYPE = "D"
        OR WS-TRANSACTION-TYPE = "W")
        AND FUNCTION TEST-NUMVAL(WS-AMOUNT-TEXT) = 0

        COMPUTE WS-AMOUNT = FUNCTION NUMVAL(WS-AMOUNT-TEXT)

        IF WS-AMOUNT >= 0
            ADD 1 TO WS-VALID-COUNT
            ADD WS-AMOUNT TO WS-TOTAL
        ELSE
            ADD 1 TO WS-REJECTED-COUNT
        END-IF
    ELSE
        ADD 1 TO WS-REJECTED-COUNT
    END-IF
    .
